# Nightcall configuration. Copy to `.env` and edit:
#
#     cp .env.example .env
#
# `pnpm start` loads `.env` if it is there and starts without one if it is
# not, so nothing here is required to exist — but the two variables in the
# first block are required to have values before the daemon will run.
#
# `.env` is gitignored. Everything in it is inherited by the processes
# Nightcall launches (`az`, `git`, `gemini`), which is exactly how `az`
# finds its own credential — and also why nothing belongs here that you
# would not hand to those three programs.

# ── Required ────────────────────────────────────────────────────────────

# The Azure DevOps organization URL.
NIGHTCALL_ADO_ORG=https://dev.azure.com/your-org

# The boards to poll, comma-separated. A target is a BOARD, not a
# repository: `project/repository` names a board plus the repository to use
# for work items with no Development link, and a bare `project` names a
# board whose every work item must route itself through one. Listing the
# same project twice is a startup error.
NIGHTCALL_TARGETS=your-project/your-repository

# ── The safety switch ───────────────────────────────────────────────────

# Observe mode is the default: the daemon polls and logs what it would
# claim, writing nothing. Set to 1 to arm claiming and the full pipeline.
# NIGHTCALL_CLAIM=1

# ── Credentials (optional here; `az devops login` is the alternative) ────

# `az` reads this itself. Nightcall never parses it, and it never reaches
# a command line, a log, a trace, or a persisted plan.
# AZURE_DEVOPS_EXT_PAT=

# ── The `az` executable ─────────────────────────────────────────────────

# Leave this unset. `az` is the command on every platform, Windows
# included: @llm4ts/runner resolves the name through PATHEXT and runs the
# `az.cmd` Windows installs through cmd.exe, which is what a shell does for
# you when you type `az` at a prompt. (Needs @llm4ts/runner 0.13.1+; an
# older one fails with `spawn EINVAL`.)
#
# An escape hatch for an install that is not on PATH. It is a command, not
# just a name — leading arguments are part of it, and a quoted path with
# spaces stays whole.
#
# NIGHTCALL_AZ_BIN="C:\Program Files\Microsoft SDKs\Azure\CLI2\wbin\az.cmd"

# ── Azure DevOps shape ──────────────────────────────────────────────────

# Work item type created for epic children: Task, User Story, Product
# Backlog Item, Issue — whatever your process template offers.
# NIGHTCALL_ADO_WORK_ITEM_TYPE=Task

# Target branch for the pull requests Nightcall opens.
# NIGHTCALL_ADO_TARGET_BRANCH=main

# API version for the work-item comments resource, the one call with no
# first-class `az boards` verb.
#
# Must be `N.N` or `N.N-preview`. NOT `N.N-preview.3`, even though that is
# the form Microsoft's REST docs quote: `az devops invoke` compares
# versions with float(), reads "7.1-preview.3" as "7.1.3", and fails with
# "could not convert string to float". A resource suffix here is trimmed
# for you; the service still picks the right resource version.
# NIGHTCALL_ADO_API_VERSION=7.1-preview

# ── Money ───────────────────────────────────────────────────────────────

# Per-work-item budget in USD; a `factory:budget-N` tag overrides it.
# NIGHTCALL_ISSUE_BUDGET_USD=5

# Company-wide daily spend, after which nothing new is claimed.
# NIGHTCALL_DAILY_BUDGET_USD=25

# ── Pace and bounds ─────────────────────────────────────────────────────

# Seconds between heartbeats.
# NIGHTCALL_HEARTBEAT_SECONDS=120

# Concurrent engineer seats.
# NIGHTCALL_ENGINEER_PARALLELISM=1

# Attempts before a work item stays failed.
# NIGHTCALL_MAX_ATTEMPTS=2

# Coder turns per task, and wall clock per work item (mono) or per stage
# (staged). Bounded darkness: without these one degenerate task can hold
# the company's only seat for hours.
# NIGHTCALL_TURN_LIMIT=50
# NIGHTCALL_ISSUE_TIMEOUT_MINUTES=30

# `staged` splits work into plan → code → review → QA stage workers that
# run concurrently across work items; `mono` works one item end to end.
# NIGHTCALL_PIPELINE=mono

# Internal review rounds per task, and whether the reviewer seats run at
# all (the gate stays either way).
# NIGHTCALL_MAX_ROUNDS=1
# NIGHTCALL_INTERNAL_REVIEW=on

# ── Delivery ────────────────────────────────────────────────────────────

# CI gate command, run inside the worktree.
# NIGHTCALL_GATE=pnpm typecheck && pnpm test

# `off` restores the human merge gate. Otherwise the mend stage
# squash-completes a factory:review PR once its branch policies pass.
# NIGHTCALL_AUTO_MERGE=on

# Where clones, worktrees, run state and the ledger live.
# NIGHTCALL_WORKSPACE=.factory

# `project/repository#N` — standup comments land on this work item.
# NIGHTCALL_STANDUP_ITEM=

# ── Seats ───────────────────────────────────────────────────────────────

# The coding CLI. This branch defaults to gemini; set it to override.
# LLM4TS_CODER=gemini

# Deprecated alias for the above, still honoured so an older environment
# keeps working. Prefer LLM4TS_CODER.
# LLM4ZIO_CODER=

# Model for every seat, e.g. gemini-2.5-pro.
# NIGHTCALL_CODER_MODEL=

# How much the runner prints: quiet, normal, verbose.
# LLM4TS_VERBOSITY=verbose
